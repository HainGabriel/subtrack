// SubTrack — esquema de datos
// Ver docs/DATA_MODEL.md para el diagrama y las decisiones de diseño.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ────────────────────────────────────────────────────────────────
// Autenticación (forma compatible con Auth.js, lista para añadir
// proveedores OAuth en el futuro; con Credentials se usa sesión JWT
// y estas tablas de Account/Session quedan preparadas pero no son
// requeridas por el flujo actual). Ver docs/ARCHITECTURE.md.
// ────────────────────────────────────────────────────────────────

model User {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique
  emailVerified   DateTime?
  image           String?
  passwordHash    String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  isDemo          Boolean   @default(false)

  settings            UserSettings?
  accounts             Account[]
  sessions             Session[]
  categories           Category[]
  tags                 Tag[]
  paymentMethods       PaymentMethod[]
  subscriptions        Subscription[]
  payments             Payment[]
  budgets              Budget[]
  exchangeRates        ExchangeRate[]
  notifications        Notification[]
  activityLogs         ActivityLog[]
  passwordResetTokens  PasswordResetToken[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ────────────────────────────────────────────────────────────────
// Preferencias de usuario
// ────────────────────────────────────────────────────────────────

enum ThemePreference {
  LIGHT
  DARK
  SYSTEM
}

model UserSettings {
  userId               String   @id
  baseCurrency         String   @default("DOP") @db.Char(3)
  locale               String   @default("es")
  timezone             String   @default("America/Santo_Domingo")
  weekStartsOn         Int      @default(1) // 0=domingo … 6=sábado
  theme                ThemePreference @default(SYSTEM)

  notifyEmail          Boolean  @default(true)
  notifyInApp          Boolean  @default(true)
  weeklySummary        Boolean  @default(true)
  monthlySummary       Boolean  @default(true)

  onboardingCompletedAt DateTime?
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

// ────────────────────────────────────────────────────────────────
// Categorías y etiquetas
// ────────────────────────────────────────────────────────────────

model Category {
  id         String    @id @default(cuid())
  userId     String
  name       String
  color      String    @default("#6366f1")
  icon       String    @default("shapes")
  isSystem   Boolean   @default(false)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]
  budgets       Budget[]

  @@unique([userId, name])
  @@index([userId])
  @@map("categories")
}

model Tag {
  id        String   @id @default(cuid())
  userId    String
  name      String
  color     String   @default("#6366f1")
  createdAt DateTime @default(now())

  user          User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptions SubscriptionTag[]

  @@unique([userId, name])
  @@index([userId])
  @@map("tags")
}

model SubscriptionTag {
  subscriptionId String
  tagId          String

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  tag          Tag          @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([subscriptionId, tagId])
  @@map("subscription_tags")
}

// ────────────────────────────────────────────────────────────────
// Métodos de pago
// ────────────────────────────────────────────────────────────────

enum PaymentMethodType {
  CASH
  CARD
  BANK_ACCOUNT
  PAYPAL
  APPLE_PAY
  GOOGLE_PAY
  OTHER
}

model PaymentMethod {
  id         String            @id @default(cuid())
  userId     String
  type       PaymentMethodType
  alias      String
  brand      String?
  last4      String?           @db.VarChar(4)
  expMonth   Int?
  expYear    Int?
  color      String            @default("#6366f1")
  icon       String            @default("credit-card")
  archivedAt DateTime?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]
  payments      Payment[]

  @@index([userId])
  @@map("payment_methods")
}

// ────────────────────────────────────────────────────────────────
// Suscripciones
// ────────────────────────────────────────────────────────────────

enum BillingFrequency {
  WEEKLY
  MONTHLY
  BIMONTHLY
  QUARTERLY
  SEMIANNUAL
  ANNUAL
  CUSTOM
}

enum CustomIntervalUnit {
  DAY
  WEEK
  MONTH
  YEAR
}

enum SubscriptionType {
  RECURRING
  FREE_TRIAL
  CONTRACT
  INSTALLMENT
  RECURRING_PURCHASE
}

enum SubscriptionStatus {
  ACTIVE
  TRIAL
  PAUSED
  PENDING_CANCELLATION
  CANCELLED
  EXPIRED
  ARCHIVED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Subscription {
  id          String  @id @default(cuid())
  userId      String
  name        String
  provider    String?
  description String? @db.Text
  notes       String? @db.Text

  categoryId String?
  color      String  @default("#6366f1")
  icon       String  @default("box")
  iconUrl    String?

  amount        Decimal @db.Decimal(12, 4)
  currency      String  @db.Char(3)
  taxIncluded   Boolean @default(true)
  taxAmount     Decimal? @db.Decimal(12, 4)

  billingFrequency    BillingFrequency
  customIntervalCount Int?
  customIntervalUnit  CustomIntervalUnit?
  // Día de mes "intencionado" para frecuencias basadas en meses (1-31).
  // Ver docs/RECURRENCE_RULES.md — evita que el ciclo derive tras un mes corto.
  billingAnchorDay    Int?

  startDate       DateTime
  nextBillingDate DateTime
  lastPaymentDate DateTime?
  endDate         DateTime?

  subscriptionType SubscriptionType   @default(RECURRING)
  status           SubscriptionStatus @default(ACTIVE)
  autoRenew        Boolean            @default(true)
  cancelByDate     DateTime?

  paymentMethodId String?
  accountProfile  String?
  managementUrl   String?
  supportContact  String?

  seats       Int      @default(1)
  costPerSeat Decimal? @db.Decimal(12, 4)

  priority          Priority @default(MEDIUM)
  usefulnessRating  Int?

  archivedAt DateTime?
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  category      Category?          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  paymentMethod PaymentMethod?     @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  tags          SubscriptionTag[]
  payments      Payment[]
  reminderRules ReminderRule[]
  notifications Notification[]
  activityLogs  ActivityLog[]

  @@index([userId, status])
  @@index([userId, nextBillingDate])
  @@index([userId, categoryId])
  @@map("subscriptions")
}

model ReminderRule {
  id             String  @id @default(cuid())
  subscriptionId String
  // Días de anticipación relativos al vencimiento; 0 = mismo día, negativo = después de vencida.
  offsetDays     Int
  enabled        Boolean @default(true)
  createdAt      DateTime @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, offsetDays])
  @@index([subscriptionId])
  @@map("reminder_rules")
}

// ────────────────────────────────────────────────────────────────
// Pagos
// ────────────────────────────────────────────────────────────────

enum PaymentStatus {
  SCHEDULED
  PAID
  SKIPPED
  FAILED
  REFUNDED
  CANCELLED
}

model Payment {
  id             String        @id @default(cuid())
  subscriptionId String
  userId         String

  dueDate  DateTime
  paidDate DateTime?
  amount   Decimal       @db.Decimal(12, 4)
  currency String        @db.Char(3)
  status   PaymentStatus @default(SCHEDULED)

  paymentMethodId    String?
  // Copia del alias del método al momento del pago: conserva el historial
  // aunque el método de pago se elimine más adelante.
  paymentMethodLabel String?

  note      String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscription  Subscription   @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentMethod PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)

  @@unique([subscriptionId, dueDate])
  @@index([userId, status])
  @@index([userId, dueDate])
  @@map("payments")
}

// ────────────────────────────────────────────────────────────────
// Presupuestos
// ────────────────────────────────────────────────────────────────

enum BudgetScope {
  GLOBAL
  CATEGORY
}

enum BudgetPeriod {
  MONTHLY
  ANNUAL
}

model Budget {
  id                    String       @id @default(cuid())
  userId                String
  scope                 BudgetScope
  categoryId            String?
  period                BudgetPeriod
  amount                Decimal      @db.Decimal(12, 4)
  currency              String       @db.Char(3)
  alertThresholdPercent Int          @default(80)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, scope, categoryId, period])
  @@index([userId])
  @@map("budgets")
}

// ────────────────────────────────────────────────────────────────
// Tasas de cambio (manuales, con fecha; adaptador para API a futuro)
// ────────────────────────────────────────────────────────────────

enum ExchangeRateSource {
  MANUAL
  API
}

model ExchangeRate {
  id             String             @id @default(cuid())
  userId         String
  baseCurrency   String             @db.Char(3)
  quoteCurrency  String             @db.Char(3)
  rate           Decimal            @db.Decimal(18, 8)
  asOfDate       DateTime
  source         ExchangeRateSource @default(MANUAL)
  createdAt      DateTime           @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, baseCurrency, quoteCurrency, asOfDate])
  @@map("exchange_rates")
}

// ────────────────────────────────────────────────────────────────
// Notificaciones
// ────────────────────────────────────────────────────────────────

enum NotificationType {
  RENEWAL_UPCOMING
  TRIAL_ENDING
  CANCEL_DEADLINE
  PAYMENT_FAILED
  BUDGET_THRESHOLD
  PAYMENT_METHOD_EXPIRING
  WEEKLY_SUMMARY
  MONTHLY_SUMMARY
}

enum NotificationChannel {
  EMAIL
  IN_APP
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

model Notification {
  id             String           @id @default(cuid())
  userId         String
  type           NotificationType
  title          String
  body           String           @db.Text
  subscriptionId String?

  // Clave de idempotencia: p. ej. "RENEWAL_UPCOMING:{subscriptionId}:{offsetDays}:{nextBillingDate}"
  // Garantiza que el job programado nunca genere el mismo aviso dos veces.
  dedupeKey String @unique

  isRead        Boolean   @default(false)
  readAt        DateTime?
  snoozedUntil  DateTime?
  silenced      Boolean   @default(false)
  createdAt     DateTime  @default(now())

  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription?          @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  deliveries   NotificationDelivery[]

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

model NotificationDelivery {
  id             String              @id @default(cuid())
  notificationId String
  channel        NotificationChannel
  status         DeliveryStatus      @default(PENDING)
  sentAt         DateTime?
  error          String?             @db.Text
  createdAt      DateTime            @default(now())

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, channel])
  @@map("notification_deliveries")
}

// ────────────────────────────────────────────────────────────────
// Auditoría
// ────────────────────────────────────────────────────────────────

enum ActivityAction {
  CREATED
  UPDATED
  PAYMENT_RECORDED
  PAUSED
  CANCELLATION_SCHEDULED
  CANCELLED
  REACTIVATED
  ARCHIVED
  DELETED
  IMPORTED
}

model ActivityLog {
  id             String         @id @default(cuid())
  userId         String
  subscriptionId String?
  action         ActivityAction
  metadata       Json?
  createdAt      DateTime       @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("activity_logs")
}
