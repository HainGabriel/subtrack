# Copia este archivo a .env y completa los valores para desarrollo local.
# Nunca subas .env (con valores reales) al repositorio.

# ── Base de datos ────────────────────────────────────────────────
# Local/Docker: con docker compose (recomendado) → docker compose up -d db
DATABASE_URL="postgresql://subtrack:subtrack_dev_password@localhost:5432/subtrack?schema=public"

# En Supabase, DATABASE_URL debe ser la conexión CON POOL (Supavisor,
# puerto 6543, con ?pgbouncer=true) que usa la app en runtime, y DIRECT_URL
# la conexión DIRECTA (puerto 5432) que usan las migraciones — Supabase no
# permite migraciones a través del pool en modo transacción. En local/
# Docker no hace falta DIRECT_URL (cae de vuelta a DATABASE_URL). Ver
# docs/DEPLOYMENT.md para el paso a paso completo.
# DATABASE_URL="postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-xx-xxxx-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-xx-xxxx-1.pooler.supabase.com:5432/postgres"

# ── Auth.js ───────────────────────────────────────────────────────
# Genera un valor con: npx auth secret   (o: openssl rand -base64 33)
AUTH_SECRET="reemplaza-esto-con-un-valor-aleatorio-largo"
# En producción (Netlify), usa la URL real del sitio, ej:
# AUTH_URL="https://tu-sitio.netlify.app"
AUTH_URL="http://localhost:3000"

# ── Correo saliente ───────────────────────────────────────────────
# Si RESEND_API_KEY está vacío, la app usa el proveedor de desarrollo:
# los correos se registran en consola/logs en vez de enviarse de verdad.
# En un despliegue serverless (Netlify) esa bandeja en memoria NO sirve
# para probar nada real (cada invocación puede ser una instancia nueva) —
# configura un RESEND_API_KEY real antes de desplegar a producción.
RESEND_API_KEY=""
EMAIL_FROM="SubTrack <notificaciones@subtrack.local>"

# ── Job programado de notificaciones ───────────────────────────────
# Token requerido en el header "Authorization: Bearer <CRON_SECRET>"
# para invocar POST /api/cron/notifications. Genera uno único.
CRON_SECRET="reemplaza-esto-con-un-token-aleatorio"

# ── Configuración regional por defecto ─────────────────────────────
APP_DEFAULT_TIMEZONE="America/Santo_Domingo"
APP_DEFAULT_CURRENCY="DOP"
APP_DEFAULT_LOCALE="es"

NODE_ENV="development"
