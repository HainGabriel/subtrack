# Copia este archivo a .env y completa los valores para desarrollo local.
# Nunca subas .env (con valores reales) al repositorio.

# ── Base de datos ────────────────────────────────────────────────
# Con docker compose (recomendado): docker compose up -d db
DATABASE_URL="postgresql://subtrack:subtrack_dev_password@localhost:5432/subtrack?schema=public"

# ── Auth.js ───────────────────────────────────────────────────────
# Genera un valor con: npx auth secret   (o: openssl rand -base64 33)
AUTH_SECRET="reemplaza-esto-con-un-valor-aleatorio-largo"
AUTH_URL="http://localhost:3000"

# ── Correo saliente ───────────────────────────────────────────────
# Si RESEND_API_KEY está vacío, la app usa el proveedor de desarrollo:
# los correos se registran en consola/logs en vez de enviarse de verdad.
RESEND_API_KEY=""
EMAIL_FROM="SubTrack <notificaciones@subtrack.local>"

# ── Job programado de notificaciones ───────────────────────────────
# Token requerido en el header "Authorization: Bearer <CRON_SECRET>"
# para invocar POST /api/cron/notifications. Genera uno único.
CRON_SECRET="reemplaza-esto-con-un-token-aleatorio"

# ── Configuración regional por defecto ─────────────────────────────
APP_DEFAULT_TIMEZONE="America/Santo_Domingo"
APP_DEFAULT_CURRENCY="DOP"
APP_DEFAULT_LOCALE="es"

NODE_ENV="development"
